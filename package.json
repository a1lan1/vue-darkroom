    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vuetify": "^3.9.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.1",
